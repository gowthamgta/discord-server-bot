# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================

# Paste your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# (Optional) Guild ID for instant slash command synchronization during testing
# If left empty, slash commands will sync globally across all servers
TEST_GUILD_ID=

# AI Configuration (Primary: Google Gemini, Backup: Groq)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# (Hugging Face Spaces) Persistent storage: data/ is mirrored to this private dataset
# HF_TOKEN needs WRITE access: https://huggingface.co/settings/tokens
HF_TOKEN=
DATA_REPO=your-username/kralveth-bot-data
